{
  "_what": "The schedule the box runner enforces. One entry per slot: when it nominally fires, the window inside which a run is accepted, how stale its inputs may be, which engine steps run and which desks. run.py reads this file and refuses anything outside it.",
  "_tz": "America/New_York. The runner converts; the cron entries on the box are local time.",
  "quote_files": ["pm_quotes.json", "quotes.json", "quotes_min.json"],
  "slots": {
    "pre-market": {
      "cadence": "weekdays 08:00 ET (scan) / 08:45 ET (pm)",
      "nominal_et": "08:45",
      "window_et": ["07:30", "09:25"],
      "max_input_lag_min": 45,
      "steps": ["scan", "pm"],
      "scan_premarket": true,
      "desks": ["swing", "pullback", "momentum"]
    },
    "opening-range": {
      "cadence": "weekdays 10:00 ET (scan) / 10:45 ET (pm)",
      "nominal_et": "10:45",
      "window_et": ["09:45", "12:00"],
      "max_input_lag_min": 45,
      "steps": ["scan", "pm"],
      "desks": ["swing", "pullback", "momentum"]
    },
    "midday": {
      "cadence": "weekdays 12:30 ET (scan) / 13:15 ET (pm)",
      "nominal_et": "13:15",
      "window_et": ["12:15", "14:30"],
      "max_input_lag_min": 45,
      "steps": ["scan", "pm"],
      "desks": ["swing", "pullback", "momentum"]
    },
    "power-hour": {
      "cadence": "weekdays 15:00 ET (scan) / 15:45 ET (pm)",
      "nominal_et": "15:45",
      "window_et": ["14:45", "16:10"],
      "max_input_lag_min": 45,
      "steps": ["scan", "pm"],
      "desks": ["swing", "pullback", "momentum"]
    },
    "sentinel": {
      "cadence": "weekdays hourly at :35, 09:35-15:35 ET",
      "nominal_et": null,
      "window_et": ["09:30", "16:00"],
      "max_input_lag_min": 20,
      "steps": ["sentinel"],
      "desks": ["swing", "pullback", "momentum"],
      "once_per": "hour"
    },
    "watch": {
      "cadence": "weekdays 07:00 ET (pre-open) and 16:30 ET (after-hours)",
      "nominal_et": null,
      "window_et": ["06:30", "20:00"],
      "max_input_lag_min": 45,
      "steps": ["watch"],
      "desks": ["swing", "pullback", "momentum"]
    },
    "health": {
      "cadence": "weekdays 16:15 ET, or on demand",
      "nominal_et": "16:15",
      "window_et": ["00:00", "23:59"],
      "max_input_lag_min": 1440,
      "steps": ["health"],
      "desks": []
    }
  },
  "inputs": {
    "scan": {
      "required": ["scan_data.json"],
      "optional": ["bars.json", "fundamentals.json", "quotes.json", "apewisdom.json",
                   "st_trending.json", "st_gauges.json", "reddit_posts.json",
                   "rh_watchlists.json", "quotes_min.json", "options_scan.json",
                   "earnings_days.json", "option_chains.json"]
    },
    "pm": {
      "required": ["pm_quotes.json"],
      "optional": ["scan_results.json", "pm_broker.json", "pm_prices.json", "option_chains.json",
                   "earnings.json"]
    },
    "sentinel": {
      "required": ["pm_quotes.json"],
      "optional": ["pm_broker.json"]
    },
    "watch": {
      "required": ["pm_quotes.json"],
      "optional": ["pm_tradability.json", "pm_broker.json"]
    },
    "health": {
      "required": [],
      "optional": []
    }
  }
}
